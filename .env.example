# Flask application secret key
# Generate a unique random value for your own installation.
SECRET_KEY=replace-with-your-own-random-secret-key

# Database connection
# Default: SQLite database inside the instance folder
DATABASE_URL=sqlite:///phishlens.db

# Secure session cookies
# Keep False for local HTTP development.
# Set True when deployed behind HTTPS.
SESSION_COOKIE_SECURE=False
